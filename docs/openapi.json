{
  "openapi": "3.1.0",
  "info": {
    "title": "solsat-siting",
    "summary": "Site suitability for rooftop-solar factories, with satellite evidence",
    "description": "Flood history from Sentinel-1 SAR, elevation from Copernicus DEM and land-cover exclusions. Read-only; answers only for the areas listed in /v1/coverage. Resolution 80 m. Contains modified Copernicus Sentinel data; Copernicus DEM GLO-30; ESA WorldCover 2021 (CC BY 4.0). See docs/API.md for limits and caveats.",
    "version": "0.3.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readiness (503 until at least one AOI is loaded)",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/coverage": {
      "get": {
        "tags": [
          "metadata"
        ],
        "summary": "Areas this service can answer for",
        "operationId": "coverage_v1_coverage_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Coverage"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "tags": [
          "metadata"
        ],
        "summary": "All parameters of one processing run",
        "operationId": "run_v1_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "404": {
            "description": "Outside coverage or unknown run/scene",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/suitability": {
      "get": {
        "tags": [
          "suitability"
        ],
        "summary": "Suitability score for one point",
        "operationId": "suitability_v1_suitability_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "description": "Latitude, WGS84",
              "examples": [
                7.04
              ],
              "title": "Lat"
            },
            "description": "Latitude, WGS84"
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "description": "Longitude, WGS84",
              "examples": [
                100.47
              ],
              "title": "Lng"
            },
            "description": "Longitude, WGS84"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Suitability"
                }
              }
            }
          },
          "404": {
            "description": "Outside coverage or unknown run/scene",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/suitability/area": {
      "post": {
        "tags": [
          "suitability"
        ],
        "summary": "Score statistics inside a polygon (parcel or roof)",
        "description": "Roof polygons from the roof detector can be sent here. A roof is smaller than one 80 m pixel, so those get the pixel under their centre and the flag `smaller_than_pixel`. Max area 25 km².",
        "operationId": "suitability_area_v1_suitability_area_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AreaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AreaSuitability"
                }
              }
            }
          },
          "404": {
            "description": "Outside coverage or unknown run/scene",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/evidence": {
      "get": {
        "tags": [
          "evidence"
        ],
        "summary": "Which satellite scenes produced the score at a point",
        "description": "Every Sentinel-1 scene used, with the value read at the point and whether the water rule fired. These are the same numbers the score was computed from, not recomputed.",
        "operationId": "evidence_v1_evidence_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "description": "Latitude, WGS84",
              "examples": [
                7.04
              ],
              "title": "Lat"
            },
            "description": "Latitude, WGS84"
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "description": "Longitude, WGS84",
              "examples": [
                100.47
              ],
              "title": "Lng"
            },
            "description": "Longitude, WGS84"
          },
          {
            "name": "run_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Pin a processing run (default: the AOI covering the point)",
              "title": "Run Id"
            },
            "description": "Pin a processing run (default: the AOI covering the point)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evidence"
                }
              }
            }
          },
          "404": {
            "description": "Outside coverage or unknown run/scene",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/evidence/chip": {
      "get": {
        "tags": [
          "evidence"
        ],
        "summary": "PNG of a SAR scene, optical scene or data layer around a point",
        "description": "Give exactly one of `scene_id` (a Sentinel-1 scene from /v1/evidence) or `layer` (`elev`, `water_freq_wet`, `landcover`, `score`, or `s2-<YYYY-MM-DD>` for Sentinel-2 true colour). A red cross marks the point. Colour stretches are fixed so images compare across dates.",
        "operationId": "evidence_chip_v1_evidence_chip_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "description": "Latitude, WGS84",
              "examples": [
                7.04
              ],
              "title": "Lat"
            },
            "description": "Latitude, WGS84"
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "description": "Longitude, WGS84",
              "examples": [
                100.47
              ],
              "title": "Lng"
            },
            "description": "Longitude, WGS84"
          },
          {
            "name": "scene_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Scene Id"
            }
          },
          {
            "name": "layer",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Layer"
            }
          },
          {
            "name": "run_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Pin a processing run (default: the AOI covering the point)",
              "title": "Run Id"
            },
            "description": "Pin a processing run (default: the AOI covering the point)"
          },
          {
            "name": "size_m",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 30000,
              "minimum": 500,
              "description": "Width of the window in metres",
              "default": 8000,
              "title": "Size M"
            },
            "description": "Width of the window in metres"
          },
          {
            "name": "overlay",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "none",
                "water_mask"
              ],
              "type": "string",
              "default": "none",
              "title": "Overlay"
            }
          },
          {
            "name": "band",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "vv",
                "vh"
              ],
              "type": "string",
              "default": "vv",
              "title": "Band"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Outside coverage or unknown run/scene",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AoiRef": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "examples": [
              "hatyai"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "Hat Yai"
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "AoiRef"
      },
      "AreaComponents": {
        "properties": {
          "flood_freq": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flood Freq"
          },
          "elevation_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Elevation M"
          },
          "p_flood": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "P Flood"
          }
        },
        "type": "object",
        "required": [
          "flood_freq",
          "elevation_m",
          "p_flood"
        ],
        "title": "AreaComponents"
      },
      "AreaRequest": {
        "properties": {
          "geometry": {
            "$ref": "#/components/schemas/Geometry"
          }
        },
        "type": "object",
        "required": [
          "geometry"
        ],
        "title": "AreaRequest",
        "examples": [
          {
            "geometry": {
              "coordinates": [
                [
                  [
                    100.6,
                    14.275
                  ],
                  [
                    100.601,
                    14.275
                  ],
                  [
                    100.601,
                    14.276
                  ],
                  [
                    100.6,
                    14.276
                  ],
                  [
                    100.6,
                    14.275
                  ]
                ]
              ],
              "type": "Polygon"
            }
          }
        ]
      },
      "AreaSuitability": {
        "properties": {
          "aoi": {
            "$ref": "#/components/schemas/AoiRef"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "method_version": {
            "type": "string",
            "title": "Method Version"
          },
          "area_m2": {
            "type": "integer",
            "title": "Area M2"
          },
          "pixels": {
            "type": "integer",
            "title": "Pixels"
          },
          "pixel_m": {
            "type": "number",
            "title": "Pixel M"
          },
          "score_mean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score Mean"
          },
          "score_p10": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score P10",
            "description": "10th percentile: the worse end of the parcel"
          },
          "share_poor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Share Poor",
            "description": "Share of non-excluded pixels with score < 50"
          },
          "share_excluded": {
            "type": "number",
            "title": "Share Excluded"
          },
          "components": {
            "$ref": "#/components/schemas/AreaComponents"
          },
          "flags": {
            "items": {
              "type": "string",
              "const": "smaller_than_pixel"
            },
            "type": "array",
            "title": "Flags"
          },
          "evidence_url": {
            "type": "string",
            "title": "Evidence Url"
          },
          "attribution": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Attribution"
          }
        },
        "type": "object",
        "required": [
          "aoi",
          "run_id",
          "method_version",
          "area_m2",
          "pixels",
          "pixel_m",
          "score_mean",
          "score_p10",
          "share_poor",
          "share_excluded",
          "components",
          "flags",
          "evidence_url",
          "attribution"
        ],
        "title": "AreaSuitability"
      },
      "Components": {
        "properties": {
          "flood": {
            "$ref": "#/components/schemas/FloodComponent"
          },
          "elevation": {
            "$ref": "#/components/schemas/ElevationComponent"
          }
        },
        "type": "object",
        "required": [
          "flood",
          "elevation"
        ],
        "title": "Components"
      },
      "Confidence": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "medium",
              "low"
            ],
            "title": "Level",
            "description": "low when more than 2 flags apply"
          },
          "flags": {
            "items": {
              "type": "string",
              "enum": [
                "few_wet_scenes",
                "vegetated_flooding_not_detected",
                "urban_flooding_not_detected",
                "elevation_is_dsm",
                "near_permanent_water",
                "aoi_edge"
              ]
            },
            "type": "array",
            "title": "Flags"
          }
        },
        "type": "object",
        "required": [
          "level",
          "flags"
        ],
        "title": "Confidence"
      },
      "Coverage": {
        "properties": {
          "aois": {
            "items": {
              "$ref": "#/components/schemas/CoverageAoi"
            },
            "type": "array",
            "title": "Aois"
          }
        },
        "type": "object",
        "required": [
          "aois"
        ],
        "title": "Coverage"
      },
      "CoverageAoi": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "bbox": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bbox",
            "description": "[west, south, east, north], WGS84"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "method_version": {
            "type": "string",
            "title": "Method Version"
          },
          "pixel_m": {
            "type": "number",
            "title": "Pixel M"
          },
          "date_range": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Date Range",
            "description": "[first, last] Sentinel-1 date used"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "bbox",
          "run_id",
          "method_version",
          "pixel_m",
          "date_range"
        ],
        "title": "CoverageAoi"
      },
      "ElevationComponent": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value",
            "description": "Smoothed Copernicus DEM height in metres (a surface model)"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "p_flood": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "P Flood",
            "description": "P(flooded | height), learned inside this AOI only"
          },
          "subscore": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subscore"
          },
          "weight": {
            "type": "number",
            "title": "Weight"
          }
        },
        "type": "object",
        "required": [
          "value",
          "unit",
          "p_flood",
          "subscore",
          "weight"
        ],
        "title": "ElevationComponent"
      },
      "ErrorDetail": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error",
            "examples": [
              "outside_coverage"
            ]
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "available_aois": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available Aois"
          },
          "max_m2": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max M2"
          },
          "area_m2": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Area M2"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "string"
              },
              {
                "items": {},
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "FastAPI wraps errors as {\"detail\": ...}. For 404/422 raised by this service detail is an ErrorDetail."
      },
      "Evidence": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "method": {
            "$ref": "#/components/schemas/EvidenceMethod"
          },
          "point": {
            "$ref": "#/components/schemas/EvidencePoint"
          },
          "summary": {
            "$ref": "#/components/schemas/EvidenceSummary"
          },
          "scenes": {
            "items": {
              "$ref": "#/components/schemas/Scene"
            },
            "type": "array",
            "title": "Scenes"
          },
          "layers": {
            "items": {
              "$ref": "#/components/schemas/LayerRef"
            },
            "type": "array",
            "title": "Layers"
          },
          "optical_reference": {
            "items": {
              "$ref": "#/components/schemas/OpticalRef"
            },
            "type": "array",
            "title": "Optical Reference"
          },
          "attribution": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Attribution"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "method",
          "point",
          "summary",
          "scenes",
          "layers",
          "optical_reference",
          "attribution"
        ],
        "title": "Evidence"
      },
      "EvidenceMethod": {
        "properties": {
          "version": {
            "type": "string",
